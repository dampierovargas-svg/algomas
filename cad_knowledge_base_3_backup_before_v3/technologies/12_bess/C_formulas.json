  {
    "calculation_id": "BESS-C-002",
    "name_es": "Estimacion de SOC (coulomb counting + voltage + Kalman)",
    "purpose": "Estima SOC por fusion de coulomb counting y voltage + filtro de Kalman extendido (EKF).",
    "applicability_expression": "technology == '12_bess'",
    "input_field_ids": [
      "BESS-008",
      "BESS-009",
      "BESS-064",
      "BESS-065",
      "BESS-012"
    ],
    "derived_input_ids": [
      "BESS-C-001"
    ],
    "equations_ascii": [
      "SOC(t+dt) = SOC(t) - I*C_rate^(-1) dt",
      "SOC_v = f^-1(V_oc)",
      "SOC = w1*SOC_c + (1-w1)*SOC_v (Kalman gain K)"
    ],
    "equations_latex": [
      "SOC(t+dt) = SOC(t) - \\frac{I}{C_n} \\, dt",
      "SOC_v = f^{-1}(V_{oc})",
      "SOC = K \\cdot SOC_v + (1-K) \\cdot SOC_c"
    ],
    "variables": [
      {
        "name": "I",
        "unit": "A"
      },
      {
        "name": "C_n",
        "unit": "Ah"
      },
      {
        "name": "dt",
        "unit": "s"
      }
    ],
    "unit_equations": [
      "SOC [-] = SOC[-] - I [A] dt [s] / (C_n [Ah] * 3600 [s/h])"
    ],
    "numerical_method": "Extended Kalman Filter with Q=1e-4, R=1e-3",
    "iteration_limits": {
      "max_iter": 2000,
      "tolerance_SOC": 0.01
    },
    "validity_limits": [
      "|I| <= 5*C_n",
      "T en [-20,55] degC"
    ],
    "outputs": [
      {
        "name": "SOC",
        "unit": "-",
        "min": 0,
        "max": 1
      }
    ],
    "acceptance_rules": [
      "|SOC - SOC_medido| < 2%"
    ],
    "failure_modes": [
      "Calibracion offset, deriva integrador > 5%"
    ],
    "drawing_impacts": [
      "BESS-DRW-005",
      "BESS-DRW-012"
    ],
    "source_ids": [
      "IEC_62933_2_1",
      "IEC_62619",
      "DNV_RP_0585",
      "IEC_62897"
    ]
  },
  {
    "calculation_id": "BESS-C-003",
    "name_es": "Capacidad residual (fade por ciclo y calendario)",
