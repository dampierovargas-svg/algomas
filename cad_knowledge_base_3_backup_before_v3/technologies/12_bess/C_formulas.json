        "name": "SOH",
        "unit": "-",
        "min": 0,
        "max": 1
      }
    ],
    "acceptance_rules": [
      "SOH >= SOH_minimo (BESS-066)"
    ],
    "failure_modes": [
      "SOH < 0.6 -> reemplazo"
    ],
    "drawing_impacts": [
      "BESS-DRW-005",
      "BESS-DRW-012",
      "BESS-DRW-013"
    ],
    "source_ids": [
      "IEC_62933_2_1",
      "IEC_62619",
      "UL_9540A",
      "DNV_RP_0585"
    ]
