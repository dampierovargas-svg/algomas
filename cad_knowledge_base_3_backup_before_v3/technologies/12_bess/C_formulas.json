[
  {
    "calculation_id": "BESS-C-001",
    "name_es": "Tension de celda (OCV vs SOC)",
    "purpose": "Estima la tension de circuito abierto de la celda como funcion de SOC, T y quimica.",
    "applicability_expression": "technology == '12_bess' AND BESS-007 IS NOT NULL",
    "input_field_ids": [
      "BESS-007",
      "BESS-009",
      "BESS-010",
      "BESS-011",
      "BESS-064",
      "BESS-065"
    ],
    "derived_input_ids": [],
    "equations_ascii": [
      "V_oc(SOC,T) = a0 + a1*SOC + a2*T + a3*SOC*T (LFP)",
      "V_oc(SOC) = Vnom + (Vmax - Vmin)*(SOC - 0.5) (NMC lineal)"
    ],
    "equations_latex": [
      "V_{oc}(SOC,T) = a_0 + a_1 SOC + a_2 T + a_3 SOC T",
      "V_{oc}(SOC) = V_{nom} + (V_{max}-V_{min})(SOC - 0.5)"
    ],
    "variables": [
      {
        "name": "SOC",
        "unit": "-"
      },
      {
        "name": "T",
        "unit": "degC"
      },
      {
        "name": "Vnom",
        "unit": "V"
      }
    ],
    "unit_equations": [
      "V_oc [V] = a0 [-] + a1 [1] SOC [-] + a2 [V/degC] T [degC] + a3 [V] SOC*T [-][degC]"
    ],
    "numerical_method": "Piecewise empirical OCV curve lookup",
    "iteration_limits": {
      "max_iter": 50,
      "tolerance_V": 0.005
    },
    "validity_limits": [
      "SOC en [0,1]",
      "T en [-20,55] degC",
      "V_oc en [Vmin,Vmax]"
    ],
    "outputs": [
      {
        "name": "V_oc",
        "unit": "V",
        "min": 1.5,
        "max": 4.4
      }
    ],
    "acceptance_rules": [
      "|V_oc_estimado - V_oc_datasheet| < 50 mV"
    ],
    "failure_modes": [
      "Datos OCV fuera de rango -> reintegrar curva"
    ],
    "drawing_impacts": [
      "BESS-DRW-005",
      "BESS-DRW-006"
    ],
    "source_ids": [
      "IEC_62660_1",
