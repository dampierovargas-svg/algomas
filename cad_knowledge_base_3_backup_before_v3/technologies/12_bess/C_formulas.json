        "name": "C_res",
        "unit": "Ah"
      },
      {
        "name": "R_now",
        "unit": "mOhm"
      }
    ],
    "unit_equations": [
      "SOH [-] = 0.5 * (C_res [Ah] / C_n [Ah] + R_init [mOhm] / R_now [mOhm])"
    ],
    "numerical_method": "Linear weighted",
    "iteration_limits": {
      "max_iter": 10,
      "tolerance": 0.01
    },
    "validity_limits": [
