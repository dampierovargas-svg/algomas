  {
    "calculation_id": "BESS-C-004",
    "name_es": "SOH (capacity fade + resistance)",
    "purpose": "Calcula State of Health combinando fade de capacidad y aumento de resistencia.",
    "applicability_expression": "technology == '12_bess'",
    "input_field_ids": [
