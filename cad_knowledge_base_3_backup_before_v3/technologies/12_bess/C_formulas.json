      {
        "name": "DOD",
        "unit": "-"
      },
      {
        "name": "N_eq",
        "unit": "cyc"
      },
      {
        "name": "t",
        "unit": "year"
      }
    ],
    "unit_equations": [
      "C_res [Ah] = C_n [Ah] * (1 - alpha_c [1/cyc] * N_eq [cyc] - alpha_cal [1/year] * t [year])"
    ],
    "numerical_method": "Semi-empirical model",
    "iteration_limits": {
      "max_iter": 100,
      "tolerance_Ah": 0.5
    },
    "validity_limits": [
      "N_eq <= 15000",
      "t <= 25 year"
    ],
    "outputs": [
      {
        "name": "C_res",
        "unit": "Ah",
        "min": 60.0,
        "max": 100
      }
    ],
    "acceptance_rules": [
      "C_res >= 0.6*C_n a EOL"
    ],
    "failure_modes": [
      "Parametros de fade fuera de rango"
    ],
    "drawing_impacts": [
      "BESS-DRW-005",
      "BESS-DRW-007"
    ],
    "source_ids": [
      "IEC_62660_2",
      "IEC_62619",
      "UL_9540A",
      "DNV_RP_0585"
    ]
