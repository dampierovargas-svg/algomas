    "derived_input_ids": [
      "BESS-C-003"
    ],
    "equations_ascii": [
      "SOH_cap = C_res / C_n",
      "SOH_res = R_init / R_now",
      "SOH = 0.5*(SOH_cap + SOH_res)"
    ],
    "equations_latex": [
      "SOH_{cap} = \\frac{C_{res}}{C_n}",
      "SOH_{res} = \\frac{R_{init}}{R_{now}}",
