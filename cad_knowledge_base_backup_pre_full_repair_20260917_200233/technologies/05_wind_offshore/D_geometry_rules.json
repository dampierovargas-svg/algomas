  {
    "rule_id": "WOF-GEO-001",
    "name_es": "Cuadricula de micrositing offshore",
    "description": "Malla regular o alineada de WT respetando separacion minima 7D",
    "geometry_type": "POINT_GRID",
    "parameters": {
      "min_spacing_D": 7,
      "rotation_deg": 0
    },
    "conditional_expression": "always",
    "validation_expression": "for every WT pair: dist >= 7*rotor_diameter_m",
