    "algorithm": "Distribución de wellpads según localización de pozos y distancia entre productores/reinyectores",
    "algorithm_pseudocode": [
      "for each well w in wells_list:",
      "  place wellpad polygon(w.location, area)",
      "  ensure clearance(w, road_access, >= 4 m)",
      "  assert distance(w_prod, w_inj) >= min_reinj_offset"
    ],
