        "name": "access_road",
        "value": "GEO-123",
        "min_m": 4
      }
    ],
    "collision_rules": [
      {
        "rule": "no overlap of wellpads",
        "error": "wellpads overlap"
      },
      {
        "rule": "access road reaches each wellpad",
        "error": "missing access"
      }
    ],
    "references": [
      "ISO_19111;ISO_14685;ISO_5457;ISO_7200;ISO_129_1;ISO_128_20;ISO_5455;ANSI_Y14_5;ISO_13567_1"
